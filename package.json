{
  "name": "tyandor-design",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check:contrast": "bun run scripts/check-contrast.ts",
    "check:palette": "bun run scripts/check-palette-drift.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "ci": "bun run typecheck && bun run build && bun run check:contrast && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
