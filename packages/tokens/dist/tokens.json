{
  "$schema": "https://tyandor.com/schemas/tokens-1.json",
  "name": "@tyandor/tokens",
  "description": "Carbon's token taxonomy, the Expanse palette's values. Canonical machine-readable source for downstream theme generators (terminal, nvim).",
  "variants": [
    "mcrn",
    "earth"
  ],
  "palette": {
    "backgrounds": {
      "base": {
        "name": "Base",
        "mcrn": "#050910",
        "earth": "#eef2f5",
        "role": "Page background, deepest layer"
      },
      "surface": {
        "name": "Surface",
        "mcrn": "#080c12",
        "earth": "#f5f7f9",
        "role": "Editor, card backgrounds"
      },
      "overlay": {
        "name": "Overlay",
        "mcrn": "#0c1820",
        "earth": "#ffffff",
        "role": "Floating panels, modals, menus"
      },
      "raised": {
        "name": "Raised",
        "mcrn": "#0d1a22",
        "earth": "#e8edf2",
        "role": "Hover states, active rows"
      }
    },
    "foregrounds": {
      "muted": {
        "name": "Muted",
        "mcrn": "#2a6a7a",
        "earth": "#8a9aaa",
        "role": "Line numbers, disabled text, indent guides"
      },
      "subtle": {
        "name": "Subtle",
        "mcrn": "#4a8a9a",
        "earth": "#6a7a8a",
        "role": "Comments, placeholders, secondary info"
      },
      "text": {
        "name": "Text",
        "mcrn": "#7ecfcf",
        "earth": "#2a3a4a",
        "role": "Body text, primary readout"
      },
      "bright": {
        "name": "Bright",
        "mcrn": "#e8f0f0",
        "earth": "#0f1a2a",
        "role": "Headings, emphasized content"
      }
    },
    "accents": {
      "amber": {
        "name": "Amber",
        "mcrn": "#e8c97a",
        "earth": "#b8860b",
        "role": "Cursor, command input, function definitions",
        "tagline": "Human warmth in cold vacuum"
      },
      "cyan": {
        "name": "Cyan",
        "mcrn": "#7ecfcf",
        "earth": "#0a7a8a",
        "role": "Primary readout, links, variables",
        "tagline": "Ship systems nominal"
      },
      "ice": {
        "name": "Ice",
        "mcrn": "#8ab8d0",
        "earth": "#1a5276",
        "role": "Keywords, control flow, structural syntax",
        "tagline": "Martian authority"
      },
      "teal": {
        "name": "Teal",
        "mcrn": "#5ab0a0",
        "earth": "#1a7a6a",
        "role": "Types, structures, namespaces",
        "tagline": "Engineering backbone"
      },
      "green": {
        "name": "Green",
        "mcrn": "#5ec98e",
        "earth": "#2a7a3a",
        "role": "Strings, success, nominal status, git add",
        "tagline": "All systems go"
      },
      "gold": {
        "name": "Gold",
        "mcrn": "#c8a96e",
        "earth": "#8a6a2a",
        "role": "Constants, literals, faction labels",
        "tagline": "Belter salvage markings"
      },
      "mars": {
        "name": "Mars",
        "mcrn": "#ff6b47",
        "earth": "#c0392b",
        "role": "Errors, deletions, critical alerts",
        "tagline": "Red planet, red alert"
      },
      "flare": {
        "name": "Flare",
        "mcrn": "#ff9a3c",
        "earth": "#d4740a",
        "role": "Warnings, transponder signals, git change",
        "tagline": "Proximity klaxon"
      },
      "steel": {
        "name": "Steel",
        "mcrn": "#a0b8b8",
        "earth": "#5a6a7a",
        "role": "Builtins, brackets, neutral chrome",
        "tagline": "Bulkhead gray"
      },
      "void": {
        "name": "Void",
        "mcrn": "#1a3a4a",
        "earth": "#c0ccd6",
        "role": "Borders, separators, inactive panels",
        "tagline": "Between the stars"
      }
    },
    "highlights": {
      "low": {
        "name": "Highlight Low",
        "mcrn": "#0d1a22",
        "earth": "#e0e8ef",
        "role": "Cursorline, subtle emphasis"
      },
      "med": {
        "name": "Highlight Med",
        "mcrn": "#1a3a4a",
        "earth": "#c0ccd6",
        "role": "Selection background, visual mode"
      },
      "high": {
        "name": "Highlight High",
        "mcrn": "#2a6a7a",
        "earth": "#8ab0c8",
        "role": "Search matches, active indicators"
      }
    }
  },
  "chartSeries": [
    "cyan",
    "amber",
    "teal",
    "flare",
    "ice",
    "green"
  ],
  "roles": {
    "meta": {
      "background": {
        "kind": "surface",
        "desc": "Page background, deepest layer"
      },
      "layer-01": {
        "kind": "surface",
        "desc": "Cards, editors, first layer above the page"
      },
      "layer-02": {
        "kind": "surface",
        "desc": "Modals, menus, floating panels"
      },
      "layer-hover": {
        "kind": "surface",
        "desc": "Hover state for any layer, active rows"
      },
      "field": {
        "kind": "surface",
        "desc": "Input, textarea, select background"
      },
      "field-hover": {
        "kind": "surface",
        "desc": "Hovered input background"
      },
      "border-subtle": {
        "kind": "nontext",
        "desc": "Dividers, card outlines"
      },
      "border-strong": {
        "kind": "nontext",
        "desc": "Input outlines, emphasized boundaries"
      },
      "border-interactive": {
        "kind": "nontext",
        "desc": "Selected/active control boundary"
      },
      "text-primary": {
        "kind": "text",
        "desc": "Body copy, primary readout"
      },
      "text-secondary": {
        "kind": "text",
        "desc": "Captions, metadata, helper text"
      },
      "text-placeholder": {
        "kind": "text",
        "desc": "Input placeholders"
      },
      "text-emphasis": {
        "kind": "text",
        "desc": "Headings, emphasized content"
      },
      "text-disabled": {
        "kind": "text",
        "desc": "Disabled control labels (WCAG-exempt)"
      },
      "text-on-color": {
        "kind": "text",
        "desc": "Text on a filled accent or support colour"
      },
      "icon-primary": {
        "kind": "nontext",
        "desc": "Default icon fill"
      },
      "icon-secondary": {
        "kind": "nontext",
        "desc": "Secondary/decorative icon fill"
      },
      "interactive": {
        "kind": "nontext",
        "desc": "Primary action fill, cursor, accent chrome"
      },
      "interactive-hover": {
        "kind": "nontext",
        "desc": "Hovered/pressed primary action"
      },
      "link": {
        "kind": "text",
        "desc": "Inline and navigation links"
      },
      "link-hover": {
        "kind": "text",
        "desc": "Hovered link"
      },
      "focus": {
        "kind": "nontext",
        "desc": "Focus ring"
      },
      "focus-inset": {
        "kind": "nontext",
        "desc": "Inner ring drawn inside the focus ring"
      },
      "support-error": {
        "kind": "text",
        "desc": "Errors, destructive actions"
      },
      "support-warning": {
        "kind": "text",
        "desc": "Warnings, degraded status"
      },
      "support-success": {
        "kind": "text",
        "desc": "Success, nominal status"
      },
      "support-info": {
        "kind": "text",
        "desc": "Informational status"
      },
      "highlight": {
        "kind": "surface",
        "desc": "Selection background, visual mode"
      },
      "highlight-strong": {
        "kind": "surface",
        "desc": "Search matches, active indicators"
      },
      "overlay": {
        "kind": "scrim",
        "desc": "Modal/drawer scrim (Base and Text at alpha)"
      }
    },
    "mcrn": {
      "background": "#050910",
      "layer-01": "#080c12",
      "layer-02": "#0c1820",
      "layer-hover": "#0d1a22",
      "field": "#080c12",
      "field-hover": "#0d1a22",
      "border-subtle": "#1a3a4a",
      "border-strong": "#2a6a7a",
      "border-interactive": "#e8c97a",
      "text-primary": "#7ecfcf",
      "text-secondary": "#4a8a9a",
      "text-placeholder": "#2a6a7a",
      "text-emphasis": "#e8f0f0",
      "text-disabled": "#2a6a7a",
      "text-on-color": "#050910",
      "icon-primary": "#7ecfcf",
      "icon-secondary": "#4a8a9a",
      "interactive": "#e8c97a",
      "interactive-hover": "#c8a96e",
      "link": "#7ecfcf",
      "link-hover": "#8ab8d0",
      "focus": "#e8c97a",
      "focus-inset": "#050910",
      "support-error": "#ff6b47",
      "support-warning": "#ff9a3c",
      "support-success": "#5ec98e",
      "support-info": "#8ab8d0",
      "highlight": "#1a3a4a",
      "highlight-strong": "#2a6a7a",
      "overlay": "rgba(5, 9, 16, 0.72)"
    },
    "earth": {
      "background": "#eef2f5",
      "layer-01": "#f5f7f9",
      "layer-02": "#ffffff",
      "layer-hover": "#e8edf2",
      "field": "#f5f7f9",
      "field-hover": "#e8edf2",
      "border-subtle": "#c0ccd6",
      "border-strong": "#8a9aaa",
      "border-interactive": "#b8860b",
      "text-primary": "#2a3a4a",
      "text-secondary": "#6a7a8a",
      "text-placeholder": "#8a9aaa",
      "text-emphasis": "#0f1a2a",
      "text-disabled": "#8a9aaa",
      "text-on-color": "#eef2f5",
      "icon-primary": "#2a3a4a",
      "icon-secondary": "#6a7a8a",
      "interactive": "#b8860b",
      "interactive-hover": "#8a6a2a",
      "link": "#0a7a8a",
      "link-hover": "#1a5276",
      "focus": "#b8860b",
      "focus-inset": "#eef2f5",
      "support-error": "#c0392b",
      "support-warning": "#d4740a",
      "support-success": "#2a7a3a",
      "support-info": "#1a5276",
      "highlight": "#c0ccd6",
      "highlight-strong": "#8ab0c8",
      "overlay": "rgba(42, 58, 74, 0.48)"
    }
  },
  "spacing": {
    "10": "4rem",
    "11": "5rem",
    "12": "6rem",
    "13": "10rem",
    "01": "0.125rem",
    "02": "0.25rem",
    "03": "0.5rem",
    "04": "0.75rem",
    "05": "1rem",
    "06": "1.5rem",
    "07": "2rem",
    "08": "2.5rem",
    "09": "3rem"
  },
  "sizes": {
    "sm": "2rem",
    "md": "2.5rem",
    "lg": "3rem"
  },
  "breakpoints": {
    "sm": "20rem",
    "md": "42rem",
    "lg": "66rem",
    "xlg": "82rem",
    "max": "99rem"
  },
  "grid": {
    "columns": 16,
    "miniUnit": "0.5rem",
    "gutter": "2rem",
    "gutterCondensed": "0.0625rem",
    "measure": "65ch"
  },
  "type": {
    "fontFamily": {
      "body": "\"iA Writer Duo\", \"iA Writer Duospace\", ui-monospace, SFMono-Regular, Menlo, monospace",
      "mono": "\"iA Writer Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
      "prose": "\"iA Writer Duo\", \"iA Writer Duospace\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "scale": {
      "code-01": {
        "size": "0.8125rem",
        "lineHeight": "1.5",
        "weight": "400",
        "letterSpacing": "0"
      },
      "code-02": {
        "size": "0.875rem",
        "lineHeight": "1.55",
        "weight": "400",
        "letterSpacing": "0"
      },
      "body-01": {
        "size": "0.9375rem",
        "lineHeight": "1.6",
        "weight": "400",
        "letterSpacing": "0"
      },
      "body-02": {
        "size": "1rem",
        "lineHeight": "1.65",
        "weight": "400",
        "letterSpacing": "0"
      },
      "heading-01": {
        "size": "0.9375rem",
        "lineHeight": "1.5",
        "weight": "600",
        "letterSpacing": "0"
      },
      "heading-02": {
        "size": "1rem",
        "lineHeight": "1.5",
        "weight": "600",
        "letterSpacing": "0"
      },
      "heading-03": {
        "size": "1.25rem",
        "lineHeight": "1.45",
        "weight": "600",
        "letterSpacing": "-0.01em"
      },
      "heading-04": {
        "size": "1.75rem",
        "lineHeight": "1.35",
        "weight": "600",
        "letterSpacing": "-0.015em"
      },
      "heading-05": {
        "size": "2rem",
        "lineHeight": "1.3",
        "weight": "600",
        "letterSpacing": "-0.02em"
      },
      "heading-06": {
        "size": "2.625rem",
        "lineHeight": "1.2",
        "weight": "600",
        "letterSpacing": "-0.02em"
      },
      "display-01": {
        "size": "2.625rem",
        "lineHeight": "1.15",
        "weight": "700",
        "letterSpacing": "-0.025em"
      },
      "display-02": {
        "size": "3.375rem",
        "lineHeight": "1.1",
        "weight": "700",
        "letterSpacing": "-0.03em"
      }
    }
  },
  "motion": {
    "duration": {
      "fast-01": "70ms",
      "fast-02": "110ms",
      "moderate-01": "150ms",
      "moderate-02": "240ms",
      "slow-01": "400ms",
      "slow-02": "700ms"
    },
    "easing": {
      "standard-productive": "cubic-bezier(0.2, 0, 0.38, 0.9)",
      "standard-expressive": "cubic-bezier(0.4, 0.14, 0.3, 1)",
      "entrance-productive": "cubic-bezier(0, 0, 0.38, 0.9)",
      "entrance-expressive": "cubic-bezier(0, 0, 0.3, 1)",
      "exit-productive": "cubic-bezier(0.2, 0, 1, 0.9)",
      "exit-expressive": "cubic-bezier(0.4, 0.14, 1, 1)"
    }
  },
  "shadow": {
    "01": {
      "mcrn": "none",
      "earth": "0 1px 2px 0 rgba(42, 58, 74, 0.08)"
    },
    "02": {
      "mcrn": "none",
      "earth": "0 2px 6px -1px rgba(42, 58, 74, 0.10), 0 1px 2px -1px rgba(42, 58, 74, 0.06)"
    },
    "03": {
      "mcrn": "none",
      "earth": "0 8px 24px -4px rgba(42, 58, 74, 0.12), 0 2px 6px -2px rgba(42, 58, 74, 0.08)"
    }
  }
}
